              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TR_START_T1_PEND</name>
              <description>TR T1 Start Pending Status</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
