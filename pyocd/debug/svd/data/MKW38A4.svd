              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>No destination bus error.</description>
                  <value>#0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>The most-recently recorded error was a bus error on a destination write.</description>
