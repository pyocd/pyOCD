                <enumeratedValue>
                  <name>01</name>
                  <description>use ring oscillator divided-by-2</description>
                  <value>#01</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>use ring oscillator divided-by-4</description>
