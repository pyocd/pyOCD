                  <value>#00</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01</name>
                  <description>1 protocol clock cycle between SCK edge and SIN sample</description>
                  <value>#01</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10</name>
                  <description>2 protocol clock cycles between SCK edge and SIN sample</description>
                  <value>#10</value>
                </enumeratedValue>
