                <enumeratedValue>
                  <name>001</name>
                  <description>Update factor is 1/2</description>
                  <value>#001</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010</name>
                  <description>Update factor is 1/4 + 1/8</description>
                  <value>#010</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011</name>
                  <description>Update factor is 1/4</description>
