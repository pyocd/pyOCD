                </enumeratedValue>
                <enumeratedValue>
                  <name>100</name>
                  <description>Update factor is 1/8 + 16</description>
                  <value>#100</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101</name>
                  <description>Update factor is 1/8</description>
                  <value>#101</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>110</name>
                  <description>Update factor is 1/16 + 1/32</description>
                  <value>#110</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>111</name>
                  <description>Update factor is 1/16</description>
                  <value>#111</value>
                </enumeratedValue>
